            android:id="@+id/liquidGlassView"
            android:layout_width="0dp"
            android:layout_height="56dp"
            app:adaptiveTint="true"
            app:backdropSourceId="@+id/prompts"
            app:bevelWidth="32dp"
            app:blurAmount="1.0"
            app:cornerRadius="32dp"
            app:dispersionStrength="0.1"
            app:glassMaterial="clear"
            app:glassTint="@color/accent_300"
            app:glassTintStrength="1.0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:refractionFalloff="1.0"
            app:refractionHeight="128dp"
            app:saturation="140.0"
            app:sensorHighlight="false">

